<resources>
    <!-- 黒い布地のホーム画面。背景は HomeActivity が布の模様で描くので、ここでは同じ黒を敷いておく -->
    <style name="Theme.FlipHome" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/cloth</item>
        <item name="android:colorBackground">@color/cloth</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
