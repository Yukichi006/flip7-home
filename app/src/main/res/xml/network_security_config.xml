<?xml version="1.0" encoding="utf-8"?>
<!-- 暗号化しない通信（http）は使わない。信頼するのは端末に最初から入っている証明書だけ（ユーザーが足した証明書は信頼しない） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
