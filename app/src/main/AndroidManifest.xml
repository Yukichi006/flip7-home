<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 「今日の予定」に、今日の予定を表示する -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 接続中の Bluetooth 機器の電池残量を読む -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 明るさのフェーダーで、画面の明るさを変える（「システム設定の変更」で許可したときだけ） -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- 下へスワイプで通知を開く -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- 天気の部品のためだけに、インターネットにつなぐ。つなぐ先は Open-Meteo（api.open-meteo.com と
         geocoding-api.open-meteo.com）だけで、送るのは選んだ地点の緯度・経度と、地点を探すときの地名だけ。
         暗号化しない通信（http）は network_security_config で禁止している -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ロック画面の刺繍の「動く壁紙」を持っている（なくても動く） -->
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

    <queries>
        <!-- ホーム画面とアプリ一覧に、インストール済みのアプリを並べる -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 下段に置く標準アプリ（電話・カメラ・設定）を探す -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".FlipHomeApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FlipHome">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <!-- ホームアプリとして選べるようにする -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- インストール直後に開いて、ホームアプリに設定できるようにする -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知の印のために、どのアプリに通知が来ているかだけを知る（通知へのアクセスを許可したときだけ動く） -->
        <service
            android:name=".BadgeListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ロック画面の刺繍の「動く壁紙」。壁紙に選んだときだけ動き、ロック画面が出るたびに今日のカレンダーを描く。
             BIND_WALLPAPER は「システムの壁紙の仕組みだけがつなげる」という守りで、FlipHome が何かの権限を得るわけではない -->
        <service
            android:name=".LockWallpaper"
            android:exported="true"
            android:label="@string/lock_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/lock_wallpaper" />
        </service>
    </application>
</manifest>
