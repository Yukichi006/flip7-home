<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 「今日の予定」に、今日の予定を表示する -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 接続中の Bluetooth 機器の電池残量を読む -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 下へスワイプで通知を開く -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- インターネットには一切つながない（端末の中のデータが外へ出ることはない）。
         今後ライブラリなどが勝手にこの権限を足しても、ここで取り除く -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <queries>
        <!-- ホーム画面とアプリ一覧に、インストール済みのアプリを並べる -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 下段に置く標準アプリ（電話・カメラ・設定）を探す -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FlipHome">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <!-- ホームアプリとして選べるようにする -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- インストール直後に開いて、ホームアプリに設定できるようにする -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
